# Third-party clones — disposable, never committed (and unlicensed data stays out of our repo)
external/

# Generated data and model outputs (release-as-data-bus later if needed)
output/
# ONE EXCEPTION, added 2026-09-14. This is 278 bytes of FITTED CONSTANTS, not
# data: five per-class sitting-member slopes. fit_seats_full.R hard-stops
# without it whenever AUSPOL_MP_SLOPE=1, which is the published default, and
# the file is produced by scripts/fit_mp_slope.R, which needs
# output/candidacies.csv, which needs build_candidacies.R, which needs
# external/reference/ directories CI never populates. That deadlock took the
# nightly Forecast refresh down for six consecutive runs (2026-09-10 to 09-14)
# and it was found only by opening the Actions tab.
#
# Tracking it lets the monitor run the REAL published configuration rather
# than a variant of it -- the alternative (AUSPOL_MP_SLOPE=0 in the workflow)
# would have the nightly job report numbers for a model that is not the one
# that ships, which defeats the point of the job.
#
# REFIT IT when output/candidacies.csv changes: Rscript scripts/fit_mp_slope.R.
# Provenance for the committed copy is in docs/CONSTANTS.md. Remove this
# exception once build_candidacies.R can run in CI -- that is the real fix and
# is already queued (NEWS 0.4.34).
!output/
output/*
!output/mp-slope-by-class.csv
# TWO MORE EXCEPTIONS, added 2026-09-17. These feed the "AEF-7 Seat Ledger"
# artifact -- Pete's main day-to-day debugging tool -- and have NO builder
# script: aef7-seat-groups.csv is 34 hand-assigned failure-category labels
# (which specific seats cluster in the same unresolved pattern, e.g. "missed
# together, cause unknown") from real analysis sessions, and
# aef7-final-two-and-tcp-reference.csv is AEF's own published TCP scenario
# data plus a two-candidate-preferred derivation for South Australia (43 of
# 47 seats confirmed against the official pair). Neither depends on OUR
# model, so neither needs regenerating when our forecast changes -- but
# losing them means re-deriving analysis that took real sessions to produce,
# the exact mistake CLAUDE.md's "keep raw scraped data" rule exists to
# prevent, extended to hand-curated analysis instead of a scrape.
# scripts/build_aef7_ledger_data.R reads both; it does NOT regenerate them.
!output/aef7-seat-groups.csv
!output/aef7-final-two-and-tcp-reference.csv
*.parquet
*.rds

# R
.Rproj.user/
.Rhistory
.RData
*.Rcheck/

# OS
Thumbs.db

# compiled objects from src/ (devtools::load_all)
src/*.o
src/*.dll
src/*.so
src/*.o-*

# Scratch copies of pipeline scripts. Rscript re-reads a script WHILE it runs,
# so a script under test gets copied rather than edited in place; those copies
# are not the source of truth and must never be committed. Two were swept in by
# a `git add -A` on 2026-09-14.
_tmp_*.R

# Victorian 2026 candidate names, derived from Wikipedia by
# scripts/parse_wikipedia_candidates.py. Tracked as an exception because CI
# cannot produce it: the raw wikitext is fetched from the network, and a
# scheduled run that scrapes Wikipedia every morning would be both rude and a
# new way for the build to fail. Same reasoning as mp-slope-by-class.csv above.
#
# The DERIVED table only, not the 133KB of raw wikitext beside it. What is
# tracked here is factual -- who is standing where, for which party -- and
# small. Refetch the source with:
#   curl -sL "https://en.wikipedia.org/w/index.php?title=Candidates_of_the_2026_Victorian_state_election&action=raw" \
#     -o external/reference/wikipedia/vic2026-candidates.wikitext
# then rerun the parser. Source: Wikipedia, CC BY-SA 4.0.
!external/reference/wikipedia/
!external/reference/wikipedia/vic2026-candidates.csv
